# 이 파일을 복사해 .env 로 저장한 뒤 값을 채우세요.  (copy .env.example .env)
# .env 는 .gitignore 에 들어 있어 GitHub에 올라가지 않습니다. 키를 채팅이나 코드에 붙여 넣지 마세요.
# 키가 비어 있으면 해당 기능만 꺼지고, 가격표와 빌더는 그대로 동작합니다.

# 웹 리서치·유튜브 검색 (https://firecrawl.dev → API Keys)
FIRECRAWL_API_KEY=

# AI 요약·조합 평가 (https://aistudio.google.com → Get API key)
GOOGLE_API_KEY=

# 먼저 시도할 Gemini 모델. 응답이 없으면 flash-lite 모델로 자동으로 넘어갑니다.
GEMINI_MODEL=gemini-flash-latest

# 🔒 기능을 여는 접근 코드. 길고 무작위인 값으로 직접 정하세요. 비어 있으면 🔒 기능이 모두 잠깁니다.
SITE_ACCESS_CODE=
